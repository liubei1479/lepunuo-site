# LEPUNUO — Cloudflare Pages 自定义响应头
# 说明：本文件仅对静态资源响应生效；函数(/api/*)响应在代码里另行设置。
# CSP 白名单依据实际外链资源：商品图 m.media-amazon.com，字体 fonts.googleapis.com / fonts.gstatic.com。

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https://m.media-amazon.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'

# JS/CSS 每次回源校验（命中 ETag 则 304，几乎无额外开销）：
# 否则老访客可能长期用旧 app.js，看不到新上线的交互改动
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

# 后台页面：禁止被任何站点嵌套（防点击劫持）
/admin.html
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'
